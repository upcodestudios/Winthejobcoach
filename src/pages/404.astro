---
import SiteLayout from "../layouts/SiteLayout.astro";
Astro.response.status = 404;
---

<SiteLayout title="Page Not Found | Win The Job" description="We can't find that page. Start from the home page, the services or the booking page.">
  <div class="mx-auto max-w-xl px-6 py-24 text-center">
    <p class="eyebrow text-primary">404</p>
    <h1 class="mt-3 text-4xl">We can't find that page</h1>
    <p class="mt-4 text-muted-foreground">It may have moved, or the link may be mistyped. Here are some places to start.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="inline-flex h-12 items-center rounded-control bg-primary px-6 text-sm font-semibold text-primary-foreground no-underline hover:bg-primary/90">Go to the home page</a>
      <a href="/services" class="inline-flex h-12 items-center rounded-control border border-border px-6 text-sm font-semibold text-foreground no-underline hover:bg-secondary">See services</a>
      <a href="/contact" class="inline-flex h-12 items-center rounded-control border border-border px-6 text-sm font-semibold text-foreground no-underline hover:bg-secondary">Contact Nick</a>
    </div>
  </div>
</SiteLayout>
