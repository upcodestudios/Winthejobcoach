---
// Return page after the hosted bookings checkout redirect. Per the kit's hard rule, a visitor
// landing here is NOT itself a success signal — the booking surface's own `confirmed` state (set
// only by a real free/offline booking) is the only real confirmation. This page is just a calm
// landing spot after the Wix-hosted checkout, in case a direct paid booking returns here instead
// of staying on the service page.
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Booking Confirmed | Win The Job" description="Your booking or package purchase with Nick Fennell is confirmed.">
  <div class="mx-auto max-w-xl py-16 text-center">
    <h1 class="text-2xl font-semibold tracking-tight">Thanks — you're all set</h1>
    <p class="mt-3 text-muted-foreground">
      If you booked a session or bought a package, a confirmation email is on its way. You can see your upcoming sessions and credits left any time on your account page.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/account"
        class="rounded-control bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground no-underline transition-opacity hover:opacity-90"
      >
        Go to my account
      </a>
      <a
        href="/"
        class="rounded-control border border-border px-6 py-3 text-sm font-medium text-foreground no-underline transition-colors hover:bg-secondary"
      >
        Back to home
      </a>
    </div>
  </div>
</SiteLayout>
