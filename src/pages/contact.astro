---
// Contact page — copy is the approved 07-Content/WTJ_Contact_Page_Copy_v1.0.md, used as written.
// The address is left out on purpose until Nick confirms it: Fort Lee, NJ and Regus only, no map.
import { organizationSchema, SITE_ORIGIN } from "../data/site";
import SiteLayout from "../layouts/SiteLayout.astro";
import ContactForm from "../components/forms/ContactForm";
import { getForm } from "../wix/forms/forms";
import type { FormDto } from "../wix/forms/types";

const FORM_ID = "a9e01ba9-70d1-4427-a4d7-f30c0d63f429"; // Wix Forms: "Contact"
let form: FormDto | null = null;
try {
  form = await getForm(FORM_ID);
} catch {
  // Guarded: an unhandled SSR throw truncates the response mid-stream; the island loads the schema itself.
}
---

<SiteLayout
  title="Contact Win The Job | Interview Coaching"
  description="Call or send a message to Win The Job about interview coaching in Fort Lee, NJ, or live on Zoom. Evening and weekend sessions."
  jsonLd={[
    { "@type": "ContactPage", "@id": `${SITE_ORIGIN}/contact#page`, url: `${SITE_ORIGIN}/contact`, name: "Contact Win The Job", about: { "@id": `${SITE_ORIGIN}/#organization` } },
    organizationSchema(),
  ]}
>
  <section class="bg-navy text-navy-foreground">
    <div class="mx-auto max-w-7xl px-6 py-14 lg:py-20">
      <p class="eyebrow text-accent">Contact Win The Job</p>
      <h1 class="mt-3 max-w-3xl text-4xl leading-tight sm:text-5xl">Let's get you ready for your next interview</h1>
      <p class="mt-5 max-w-2xl text-base text-navy-foreground/80 sm:text-lg">
        Tell us about the role you're going for and where you are in the process. We'll get back to you about how we can prepare.
      </p>
    </div>
  </section>

  <div class="mx-auto grid max-w-7xl gap-14 px-6 py-14 lg:grid-cols-2">
    <div class="space-y-10">
      <section>
        <h2 class="mt-4 text-2xl">Call us</h2>
        <p class="mt-2 text-xl font-semibold">551.225.0583</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href="tel:+15512250583" class="inline-flex h-12 items-center rounded-control bg-primary px-6 text-sm font-semibold text-primary-foreground no-underline hover:bg-primary/90">Call</a>
        </div>
      </section>

      <section>
        <h2 class="text-2xl">Email us</h2>
        <p class="mt-2 text-xl font-semibold"><a href="mailto:nick@winthejobcoach.com" class="text-foreground no-underline hover:underline">nick@winthejobcoach.com</a></p>
      </section>

      <section>
        <h2 class="text-2xl">When we coach</h2>
        <p class="mt-2 text-muted-foreground">
          Monday to Friday, 5:30 PM – 9:00 PM<br />
          Saturday and Sunday, 9:00 AM – 9:00 PM<br />
          All times Eastern.
        </p>
      </section>

      <section>
        <h2 class="text-2xl">How we can work together</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-muted-foreground">
          <li><strong class="text-foreground">Live on Zoom</strong>, wherever you are. Your Zoom link is emailed to you when you book.</li>
          <li><strong class="text-foreground">In person in Fort Lee, NJ</strong>, at our private office at the Regus Bridge Plaza or an agreed upon location.</li>
          <li><strong class="text-foreground">Between sessions</strong>, we answer your questions by phone and email.</li>
        </ul>
      </section>

      <section class="rounded-lg bg-secondary p-6">
        <h2 class="text-2xl">Not sure where to start?</h2>
        <p class="mt-2 text-muted-foreground">Book a free 30-minute Zoom consultation. We'll talk about your interview and the best way to prepare for it.</p>
        <a href="/services/free-consultation" class="mt-4 inline-flex h-12 items-center rounded-control bg-primary px-6 text-sm font-semibold text-primary-foreground no-underline hover:bg-primary/90">Book a free consultation</a>
      </section>
    </div>

    <section>
      <h2 class="text-2xl">Send a message</h2>
      <div class="mt-6">
        <ContactForm client:load formId={FORM_ID} initialForm={form ?? undefined} />
      </div>
    </section>
  </div>
</SiteLayout>
