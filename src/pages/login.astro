---
// The member sign-in / sign-up screen — carries the site's branding, since it is also the page a
// "Sign up" link lands on. Keeps the site chrome (SiteLayout) and pairs it with the logo panel.
import SiteLayout from "../layouts/SiteLayout.astro";
import LoginForm from "../components/members/LoginForm";
import logoWhite from "../assets/brand/logo-white.webp";
---

<SiteLayout title="Log In | Win The Job" description="Log in or sign up to see your coaching packages, credits left and upcoming sessions.">
  <section class="mx-auto grid max-w-5xl gap-8 px-6 py-12 lg:grid-cols-2 lg:items-start lg:gap-12 lg:py-16">
    <aside class="rounded-xl bg-navy p-8 text-navy-foreground sm:p-10">
      <img src={logoWhite.src} width={logoWhite.width} height={logoWhite.height} alt="Win The Job — Interview Coach" class="h-20 w-auto sm:h-24" />
      <p class="eyebrow mt-8 text-accent">Members</p>
      <h1 class="mt-3 text-3xl leading-tight sm:text-4xl">Your coaching, in one place</h1>
      <p class="mt-4 text-navy-foreground/80">
        Interview coaching for every stage of your career. Sign in to pick up where you left off.
      </p>
      <ul class="mt-6 space-y-2 text-sm text-navy-foreground/80">
        <li>See the credits left in your package</li>
        <li>Review upcoming and past sessions</li>
        <li>Reschedule or cancel up to 24 hours before</li>
      </ul>
    </aside>

    <div class="rounded-xl border border-border bg-background p-6 sm:p-8">
      <h2 class="text-xl font-semibold text-foreground">Sign in or create an account</h2>
      <p class="mt-1 text-sm text-muted-foreground">New to Win The Job? Choose “Sign up” to create your account.</p>
      <div class="mt-6">
        <LoginForm client:only="react" />
      </div>
    </div>
  </section>
</SiteLayout>
