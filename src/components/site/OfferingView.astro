---
// One layout for all nine service pages: hero (name, tagline, live price and length), what's
// included, who it's for, format, policy line + booking control, one testimonial, next step.
// Price, length and the Book / Buy controls come from Wix at request time — nothing here is typed in.
import PageHeader from "./PageHeader.astro";
import PolicyLine from "./PolicyLine.astro";
import CircularTestimonials from "./CircularTestimonials";
import CtaBand from "./CtaBand.astro";
import BookingSurface from "../bookings/BookingSurface";
import PlanPitch from "../pricing-plans/PlanPitch";
import { fetchOfferingBySlug, type Offering } from "../../data/offerings";
import { offeringHeaderPhoto } from "../../data/headerPhotos";
import type { ServiceDetail } from "../../wix/bookings/types";
import type { PlanDetail } from "../../wix/pricing-plans/types";
import type { Testimonial as T } from "../../wix/cms/testimonials";

interface Props {
  offering: Offering;
  service: ServiceDetail | null;
  plan: PlanDetail | null;
  testimonials: T[];
}
const { offering, service, plan, testimonials } = Astro.props;
const freeConsultation = offering.slug === "free-consultation" ? null : await fetchOfferingBySlug("free-consultation");
const hero =
  service
    ? [service.durationLabel, service.free ? "Free" : service.price].filter(Boolean).join(" · ")
    : plan
      ? [plan.price, plan.duration ? `valid ${plan.duration}` : ""].filter(Boolean).join(" · ")
      : "";
---

<PageHeader eyebrow="Interview coaching" title={offering.name} lede={offering.tagline} image={offeringHeaderPhoto[offering.slug]}>
  {hero && <p class="mt-6 inline-block rounded-control bg-navy-foreground/10 px-4 py-2 text-sm font-semibold text-navy-foreground">{hero}</p>}
</PageHeader>

<div class="mx-auto grid max-w-7xl grid-cols-[minmax(0,1fr)] gap-12 px-6 py-14 lg:grid-cols-[1.1fr_0.9fr]">
  <div>
    <p class="text-lg leading-relaxed text-foreground">{offering.intro}</p>

    <h2 class="mt-10 text-2xl">What's included</h2>
    <ul class="mt-4 space-y-3">
      {offering.includes.map((item) => (
        <li class="flex gap-3 text-base">
          <span aria-hidden="true" class="mt-1 text-primary">✓</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>

    <h2 class="mt-10 text-2xl">Best for</h2>
    <p class="mt-3 text-base text-muted-foreground">{offering.bestFor}</p>

    <h2 class="mt-10 text-2xl">How we meet</h2>
    <p class="mt-3 text-base text-muted-foreground">{offering.format}</p>
  </div>

  <aside class="lg:sticky lg:top-28 lg:self-start">
    <div class="rounded-lg bg-secondary p-6">
      {service && (
        <>
          <h2 class="text-xl">Book your session</h2>
          <div class="mt-3"><PolicyLine free={service.free} /></div>
          <div class="mt-6"><BookingSurface client:only="react" service={service} /></div>
        </>
      )}
      {plan && (
        <>
          <h2 class="text-xl">Buy this package</h2>
          <div class="mt-3"><PolicyLine /></div>
          <p class="mt-3 text-sm text-muted-foreground">
            After you buy, you book each session from the Book page or your account, and it uses one of your credits.
          </p>
          <div class="mt-6"><PlanPitch client:load plan={plan} /></div>
        </>
      )}
      {!service && !plan && offering.slug === "mock-interviews" && (
        <>
          <h2 class="text-xl">How to get a mock interview</h2>
          <p class="mt-3 text-base text-muted-foreground">
            Mock interviews come with Win The Job Intensive and Executive Interview Coaching. Once you've bought one of those packages, book your mock interview from the Book page or your account.
          </p>
          <div class="mt-5 flex flex-col gap-3">
            <a href="/services/win-the-job-intensive" class="inline-flex h-12 items-center justify-center rounded-control bg-primary px-6 text-sm font-semibold text-primary-foreground no-underline hover:bg-primary/90">See Win The Job Intensive</a>
            <a href="/book" class="inline-flex h-12 items-center justify-center rounded-control border border-border px-6 text-sm font-semibold text-foreground no-underline hover:bg-secondary">Book with a package credit</a>
          </div>
        </>
      )}
      {!service && !plan && offering.slug !== "mock-interviews" && (
        <>
          <h2 class="text-xl">Start with a conversation</h2>
          <p class="mt-3 text-base text-muted-foreground">
            This coaching is shaped around you, so Nick starts with a free 30-minute Zoom consultation to talk about what you need.
          </p>
          <div class="mt-3"><PolicyLine free /></div>
          <a href="/services/free-consultation" class="mt-5 inline-flex h-12 w-full items-center justify-center rounded-control bg-primary px-6 text-sm font-semibold text-primary-foreground no-underline hover:bg-primary/90">Book a free consultation</a>
        </>
      )}
    </div>
  </aside>
</div>

{testimonials.length > 0 && (
  <section class="mx-auto max-w-4xl px-6 pb-14 text-center">
    <h2 class="text-3xl text-foreground sm:text-4xl">Hear From Our Clients</h2>
    <div class="mt-6">
      <CircularTestimonials client:visible testimonials={testimonials} />
    </div>
  </section>
)}

{freeConsultation && (
  <section class="wtj-section bg-secondary">
    <div class="mx-auto max-w-7xl px-6">
      <p class="eyebrow text-primary">Not sure where to start?</p>
      <h2 class="mt-3 text-3xl text-foreground sm:text-4xl">Next step</h2>
      <a
        href={`/services/${freeConsultation.slug}`}
        class="mt-8 flex flex-col items-start gap-6 rounded-lg bg-background p-8 no-underline transition-transform hover:-translate-y-0.5 sm:flex-row sm:items-center sm:justify-between"
      >
        <div class="flex items-start gap-4">
          <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>
          </span>
          <div>
            <p class="text-xl text-foreground">{freeConsultation.name}</p>
            <p class="mt-1 text-sm text-muted-foreground">{freeConsultation.tagline}</p>
          </div>
        </div>
        <span class="inline-flex h-12 w-full shrink-0 items-center justify-center rounded-control bg-primary px-6 text-sm font-semibold text-primary-foreground sm:w-auto">
          Learn more →
        </span>
      </a>
    </div>
  </section>
)}

<CtaBand heading="Not sure which fits?" body="Book a free 30-minute Zoom consultation and talk it through with Nick." />
