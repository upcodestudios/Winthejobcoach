---
// The short policy line that sits above every Book / Buy button.
interface Props {
  free?: boolean;
}
const { free = false } = Astro.props;
---

<p class="text-sm text-muted-foreground">
  {free
    ? "Book at least 4 hours ahead. You can cancel or reschedule online up to 2 hours before your consultation."
    : "Book at least 48 hours ahead. You can cancel or reschedule online up to 24 hours before your session (48 hours for in-office mock interviews) for a full refund or a new time."}
  <a href="/booking-policy" class="font-medium text-primary underline">Read the Booking &amp; Cancellation Policy</a>.
</p>
