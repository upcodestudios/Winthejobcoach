---
// The shared navy band at the top of every non-home, non-booking page (Services, About, How It
// Works, Booking Policy, Privacy, Terms, and every service/package page via OfferingView).
// `image` is optional: three widths of one photo, already imported by the page (see
// src/data/headerPhotos.ts for the shared set and per-page assignments).
interface HeaderImage {
  src480: string;
  src960: string;
  src1376: string;
  /** CSS background-position; these are wide photos with the subject off-center, not a crop
   * tuned for every screen width by default. */
  position?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  image?: HeaderImage;
}
const { eyebrow, title, lede, image } = Astro.props;
const position = image?.position ?? "center";
---

<section
  class={image ? "header-photo relative bg-navy text-navy-foreground" : "bg-navy text-navy-foreground"}
  style={
    image
      ? {
          "--hp-480": `url("${image.src480}")`,
          "--hp-960": `url("${image.src960}")`,
          "--hp-1376": `url("${image.src1376}")`,
          backgroundPosition: position,
        }
      : undefined
  }
>
  <div class="relative z-10 mx-auto max-w-7xl px-6 py-14 lg:py-20">
    <p class="eyebrow text-accent">{eyebrow}</p>
    <h1 class="mt-3 max-w-3xl text-4xl leading-tight sm:text-5xl">{title}</h1>
    {lede && <p class="wtj-lede mt-5 max-w-2xl text-navy-foreground/80">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .header-photo {
    /* Content alone (eyebrow + h1 + lede) can be shorter than the photo needs to clear the
       subject's face at a short band height; a floor keeps the crop sane on every page. */
    min-height: 320px;
    background-size: cover;
    background-image: linear-gradient(100deg, rgba(6, 22, 68, 0.94) 0%, rgba(6, 22, 68, 0.94) 35%, rgba(6, 22, 68, 0.55) 70%, rgba(6, 22, 68, 0.3) 100%), var(--hp-480);
  }
  @media (min-width: 1024px) {
    .header-photo {
      min-height: 380px;
    }
  }
  @media (min-width: 640px) {
    .header-photo {
      background-image: linear-gradient(100deg, rgba(6, 22, 68, 0.94) 0%, rgba(6, 22, 68, 0.94) 35%, rgba(6, 22, 68, 0.55) 70%, rgba(6, 22, 68, 0.3) 100%), var(--hp-960);
    }
  }
  @media (min-width: 1024px) {
    .header-photo {
      background-image: linear-gradient(100deg, rgba(6, 22, 68, 0.94) 0%, rgba(6, 22, 68, 0.94) 35%, rgba(6, 22, 68, 0.55) 70%, rgba(6, 22, 68, 0.3) 100%), var(--hp-1376);
    }
  }
</style>
